{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": [
        "App.tsx",
        "src/**/*.ts",
        "src/**/*.tsx"
    ],
    "exclude": [
        "node_modules",
        "design_reference",
        "reference",
        "src/_legacy",
        "src/_legacy/**",
        "src/**/__tests__/**",
        "__tests__",
        "**/*.test.ts",
        "**/*.test.tsx",
        ".expo-export"
    ]
}